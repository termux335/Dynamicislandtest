<Project>

  <!--
    Satu sumber versi dan metadata untuk semua proyek Windows.
    Versi mengikuti SemVer: 0.6.0-beta berarti Tahap 1-5c sudah masuk, dengan
    batasan yang dicatat di README, dan format pengaturan masih boleh berubah
    antar rilis beta.
  -->
  <PropertyGroup>
    <Version>0.6.0-beta</Version>
    <!-- Turunan dari Version supaya -p:Version saat rilis juga tampil di UI. -->
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(Version)</InformationalVersion>
    <Product>Dynamic Island</Product>
    <Company>Dynamic Island contributors</Company>
    <Authors>Dynamic Island contributors</Authors>
    <Copyright>Copyright (c) 2026 Dynamic Island contributors</Copyright>
    <NeutralLanguage>id-ID</NeutralLanguage>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- Build yang dapat diulang: hasil sama untuk input yang sama. -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Analisis statis aktif di semua konfigurasi. Di CI peringatan menjadi
       kesalahan supaya standar kualitas tidak turun tanpa terlihat. -->
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors Condition="'$(CI)' == 'true'">true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
