<Window x:Class="DynamicIsland.App.CameraMirrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="368"
        Height="330"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Border Background="#F20B0B0B" CornerRadius="20" Padding="14" BorderBrush="#33FFFFFF" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <TextBlock x:Name="TitleText" Foreground="#FFFFFF" FontSize="14" FontWeight="SemiBold" />
                <Button x:Name="CloseButton"
                        Content="Tutup"
                        HorizontalAlignment="Right"
                        Padding="10,3"
                        Background="#1FFFFFFF"
                        Foreground="#FFFFFF"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Close_Click" />
            </Grid>

            <Border Grid.Row="1" Background="#000000" CornerRadius="14" Margin="0,10,0,0" ClipToBounds="True">
                <Image x:Name="Preview" Stretch="Uniform" />
            </Border>

            <TextBlock x:Name="StatusText"
                       Grid.Row="2"
                       Foreground="#B0B0B0"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0" />
        </Grid>
    </Border>
</Window>
