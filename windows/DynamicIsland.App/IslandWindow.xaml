<Window x:Class="DynamicIsland.App.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island"
        Width="34" Height="34"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.ContextMenu>
        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="{Binding MenuDisplayMode}">
                <MenuItem Header="{Binding MenuStandard}" IsCheckable="True" IsChecked="{Binding IsStandar, Mode=OneWay}" Click="ModeStandar_Click" />
                <MenuItem Header="{Binding MenuCompact}" IsCheckable="True" IsChecked="{Binding IsRingkas, Mode=OneWay}" Click="ModeRingkas_Click" />
            </MenuItem>
            <MenuItem Header="{Binding MenuSecondary}" IsCheckable="True" IsChecked="{Binding ShowsSecondary, Mode=OneWay}" Click="Secondary_Click" />
            <MenuItem Header="{Binding MenuAutoPlacement}" IsCheckable="True" IsChecked="{Binding AutoPlacement, Mode=OneWay}" Click="AutoPlacement_Click" />
            <MenuItem Header="{Binding MenuPosition}">
                <MenuItem Header="{Binding LabelPositionTopCenter}" IsCheckable="True" IsChecked="{Binding IsPositionTopCenter, Mode=OneWay}" Click="PositionTopCenter_Click" />
                <MenuItem Header="{Binding LabelPositionTopLeft}" IsCheckable="True" IsChecked="{Binding IsPositionTopLeft, Mode=OneWay}" Click="PositionTopLeft_Click" />
                <MenuItem Header="{Binding LabelPositionTopRight}" IsCheckable="True" IsChecked="{Binding IsPositionTopRight, Mode=OneWay}" Click="PositionTopRight_Click" />
            </MenuItem>
            <MenuItem Header="{Binding MenuPriority}">
                <MenuItem Header="{Binding LabelPriorityDefault}" IsCheckable="True" IsChecked="{Binding IsPriorityBawaan, Mode=OneWay}" Click="PriorityDefault_Click" />
                <MenuItem Header="{Binding LabelPriorityMedia}" IsCheckable="True" IsChecked="{Binding IsPriorityMedia, Mode=OneWay}" Click="PriorityMedia_Click" />
                <MenuItem Header="{Binding LabelPriorityTimer}" IsCheckable="True" IsChecked="{Binding IsPriorityTimer, Mode=OneWay}" Click="PriorityTimer_Click" />
            </MenuItem>
            <MenuItem Header="{Binding MenuQuickActions}" IsCheckable="True" IsChecked="{Binding IsQuickActionsOpen, Mode=OneWay}" Click="QuickActions_Click" />
            <MenuItem Header="{Binding MenuTimer}">
                <MenuItem Header="{Binding MenuFocus25}" Click="TimerFocus_Click" />
                <MenuItem Header="{Binding MenuStopwatch}" Click="TimerStopwatch_Click" />
                <Separator />
                <MenuItem Header="{Binding MenuTimerStop}" Click="TimerStop_Click" />
            </MenuItem>
            <MenuItem Header="{Binding MenuShelf}" IsCheckable="True" IsChecked="{Binding IsShelfOpen, Mode=OneWay}" Click="Shelf_Click" />
            <MenuItem Header="{Binding MenuShelfClear}" IsEnabled="{Binding HasShelfFiles, Mode=OneWay}" Click="ShelfClear_Click" />
            <Separator />
            <MenuItem Header="{Binding MenuAccent}">
                <MenuItem Header="{Binding LabelAccentOrange}" IsCheckable="True" IsChecked="{Binding IsAccentOranye, Mode=OneWay}" Click="AccentOrange_Click" />
                <MenuItem Header="{Binding LabelAccentBlue}" IsCheckable="True" IsChecked="{Binding IsAccentBiru, Mode=OneWay}" Click="AccentBlue_Click" />
                <MenuItem Header="{Binding LabelAccentPurple}" IsCheckable="True" IsChecked="{Binding IsAccentUngu, Mode=OneWay}" Click="AccentPurple_Click" />
                <MenuItem Header="{Binding LabelAccentGreen}" IsCheckable="True" IsChecked="{Binding IsAccentHijau, Mode=OneWay}" Click="AccentGreen_Click" />
            </MenuItem>
            <MenuItem Header="{Binding MenuLanguage}">
                <MenuItem Header="{Binding LabelLanguageId}" IsCheckable="True" IsChecked="{Binding IsLanguageId, Mode=OneWay}" Click="LanguageId_Click" />
                <MenuItem Header="{Binding LabelLanguageEn}" IsCheckable="True" IsChecked="{Binding IsLanguageEn, Mode=OneWay}" Click="LanguageEn_Click" />
            </MenuItem>
            <MenuItem Header="{Binding MenuHumor}" IsCheckable="True" IsChecked="{Binding IsHumorKocak, Mode=OneWay}" Click="Humor_Click" />
            <MenuItem Header="{Binding MenuNotifications}" IsCheckable="True" IsChecked="{Binding NotificationsEnabled, Mode=OneWay}" Click="Notifications_Click" />
            <Separator />
            <MenuItem Header="{Binding MenuSettings}" Click="Settings_Click" />
            <MenuItem Header="{Binding MenuQuit}" Click="Quit_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="TrackStyle" TargetType="ProgressBar">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="#33FFFFFF" CornerRadius="2" />
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator" Background="{DynamicResource AccentBrush}" CornerRadius="2" HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tombol ikon bundar untuk kontrol media (Segoe MDL2 Assets). -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill" Background="#1FFFFFFF" BorderBrush="Transparent" BorderThickness="2" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#4DFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill" Background="#1FFFFFFF" BorderBrush="Transparent" BorderThickness="2" CornerRadius="22" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#4DFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Kapsul utama. -->
        <Border x:Name="Capsule"
            Background="#000000"
            CornerRadius="{Binding CapsuleCornerRadius}"
            MouseLeftButtonDown="Capsule_MouseLeftButtonDown"
            MouseLeftButtonUp="Capsule_MouseLeftButtonUp"
            MouseLeave="Capsule_MouseLeave"
            MouseWheel="Capsule_MouseWheel"
            AllowDrop="True"
            DragOver="Capsule_DragOver"
            Drop="Capsule_Drop"
            AutomationProperties.Name="{Binding AccessibilityLabel}">
        <Grid>
            <!-- Idle: tidak ada aktivitas, hanya titik penanda. -->
            <Grid Visibility="{Binding ShowsIdleLayer, Converter={StaticResource BoolToVisibility}}">
                <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Opacity="0.45"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <!-- Minimal: lingkaran dengan satu titik aksen. -->
            <Grid Visibility="{Binding ShowsMinimalLayer, Converter={StaticResource BoolToVisibility}}">
                <Ellipse Width="10" Height="10" Fill="{DynamicResource AccentBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <!-- Compact: glyph, judul, progres/subjudul, garis progres di bawah. -->
            <Grid Visibility="{Binding ShowsCompactLayer, Converter={StaticResource BoolToVisibility}}">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Glyph}" Foreground="{DynamicResource AccentBrush}" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="#FFFFFF" FontSize="13"
                               FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding CompactTrailing}" Foreground="#FFB0B0B0" FontSize="12"
                               Margin="8,0,2,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasActivity, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
                <ProgressBar Style="{StaticResource TrackStyle}" Height="2" Margin="10,0,10,4"
                             VerticalAlignment="Bottom" Value="{Binding ProgressPercent, Mode=OneWay}"
                             Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <!-- Expanded: kartu penuh dengan progres dan aksi. -->
            <Grid Visibility="{Binding ShowsGenericCard, Converter={StaticResource BoolToVisibility}}" Margin="20,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Glyph}" Foreground="{DynamicResource AccentBrush}" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="#FFFFFF" FontSize="15"
                               FontWeight="SemiBold" Margin="8,0,10,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding Subtitle}" Foreground="#FFB0B0B0" FontSize="12"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <ProgressBar Grid.Row="1" Style="{StaticResource TrackStyle}" Height="3" Margin="0,8,0,0"
                             Value="{Binding ProgressPercent, Mode=OneWay}"
                             Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibility}}" />

                <ItemsControl Grid.Row="2" ItemsSource="{Binding Actions}" Margin="0,10,0,0"
                              VerticalAlignment="Bottom"
                              Visibility="{Binding HasActions, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource PillButton}" Margin="0,0,10,0" Click="Action_Click"
                                    Content="{Binding Label}" AutomationProperties.Name="{Binding Label}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- Expanded media: judul, lirik, timeline, dan kontrol putar. -->
            <Grid Visibility="{Binding ShowsMediaCard, Converter={StaticResource BoolToVisibility}}"
                  Margin="18,12" AutomationProperties.Name="{Binding AccessibilityLabel}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="{Binding Title}" Foreground="#FFFFFF" FontSize="14" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" Foreground="#FFB0B0B0" FontSize="11" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <TextBlock Grid.Row="1" Text="{Binding Caption}" Foreground="#FFD8D8D8" FontSize="12"
                           Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                           AutomationProperties.Name="{Binding LabelMediaLyrics}"
                           Visibility="{Binding HasCaption, Converter={StaticResource BoolToVisibility}}" />

                <ProgressBar Grid.Row="2" Style="{StaticResource TrackStyle}" Height="3" Margin="0,8,0,0"
                             Value="{Binding ProgressPercent, Mode=OneWay}"
                             Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibility}}" />

                <Grid Grid.Row="3" Margin="0,4,0,0"
                      Visibility="{Binding HasMediaTimes, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding MediaElapsed}" Foreground="#FFB0B0B0" FontSize="10" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding MediaDuration}" Foreground="#FFB0B0B0" FontSize="10" HorizontalAlignment="Right" />
                </Grid>

                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,6,0,0"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource IconButton}" Margin="0,0,6,0" Click="MediaPrevious_Click"
                            Content="{Binding MediaPreviousGlyph}"
                            AutomationProperties.Name="{Binding LabelMediaPrevious}"
                            ToolTip="{Binding LabelMediaPrevious}" />
                    <Button Style="{StaticResource IconButton}" Margin="0,0,6,0" Click="MediaToggle_Click"
                            Content="{Binding MediaToggleGlyph}"
                            AutomationProperties.Name="{Binding MediaToggleLabel}"
                            ToolTip="{Binding MediaToggleLabel}" />
                    <Button Style="{StaticResource IconButton}" Click="MediaNext_Click"
                            Content="{Binding MediaNextGlyph}"
                            AutomationProperties.Name="{Binding LabelMediaNext}"
                            ToolTip="{Binding LabelMediaNext}" />
                </StackPanel>
            </Grid>

            <!-- Aksi cepat (Tahap 3): panel 312 x 64 dari tekan-tahan 500 ms. -->
            <Grid Visibility="{Binding IsQuickActionsOpen, Converter={StaticResource BoolToVisibility}}">
                <Border Background="#000000" CornerRadius="{Binding CapsuleCornerRadius}" />
                <ItemsControl ItemsSource="{Binding QuickActions}" Margin="12,0" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource PillButton}" Height="40" Margin="0,0,8,0"
                                    Click="QuickAction_Click" Content="{Binding Label}"
                                    AutomationProperties.Name="{Binding Label}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- Shelf berkas (Tahap 2, khusus laptop): area putus-putus tempat menaruh berkas. -->
            <Grid Visibility="{Binding IsShelfOpen, Converter={StaticResource BoolToVisibility}}">
                <Border Background="#000000" CornerRadius="{Binding CapsuleCornerRadius}" />
                <Rectangle Margin="8" RadiusX="14" RadiusY="14" Stroke="#80FFFFFF" StrokeThickness="1.5">
                    <Rectangle.StrokeDashArray>
                        <DoubleCollection>4 3</DoubleCollection>
                    </Rectangle.StrokeDashArray>
                </Rectangle>

                <StackPanel Margin="20,14" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ShelfHeadline}" Foreground="#FFB0B0B0" FontSize="12" />
                    <ItemsControl ItemsSource="{Binding ShelfVisibleFiles}" Margin="0,8,0,0"
                                  Visibility="{Binding HasShelfFiles, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource PillButton}" Height="34" Margin="0,0,8,0"
                                        Click="ShelfFile_Click" Content="{Binding Name}"
                                        AutomationProperties.Name="{Binding Name}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Grid>
        </Border>

        <!-- Kapsul kedua (Tahap 3): minimal, klik untuk menjadikannya utama. -->
        <Border Grid.Column="1"
                Width="{Binding SecondaryWidth}"
                Height="{Binding SecondaryWidth}"
                Margin="8,0,0,0"
                Background="#000000"
                CornerRadius="{Binding SecondaryCornerRadius}"
                Cursor="Hand"
                MouseLeftButtonUp="SecondaryCapsule_MouseLeftButtonUp"
                Visibility="{Binding ShowSecondaryCapsule, Converter={StaticResource BoolToVisibility}}"
                AutomationProperties.Name="{Binding SecondaryAccessibilityLabel}">
            <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>
