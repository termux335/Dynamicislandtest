<Window x:Class="DynamicIsland.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island"
        Width="460"
        MaxHeight="720"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0B0B0B"
        Foreground="#FFFFFF"
        ShowInTaskbar="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B0B0B0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Margin" Value="0,0,18,0" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,6" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock x:Name="Headline"
                       Text="{Binding LabelSettingsTitle}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />

            <TextBlock Text="{Binding LabelSettingsIntro}" Style="{StaticResource Muted}" Margin="0,8,0,0" />

            <TextBlock Text="{Binding MenuLanguage}" Style="{StaticResource Section}" />
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="LanguageId" Content="{Binding LabelLanguageId}" Checked="LanguageId_Checked" />
                <RadioButton x:Name="LanguageEn" Content="{Binding LabelLanguageEn}" Checked="LanguageEn_Checked" />
            </StackPanel>

            <TextBlock Text="{Binding MenuPosition}" Style="{StaticResource Section}" />
            <ComboBox x:Name="PositionBox" SelectionChanged="Position_Changed" Padding="8,4">
                <ComboBoxItem Content="{Binding LabelPositionTopCenter}" />
                <ComboBoxItem Content="{Binding LabelPositionTopLeft}" />
                <ComboBoxItem Content="{Binding LabelPositionTopRight}" />
            </ComboBox>

            <TextBlock Text="{Binding MenuAccent}" Style="{StaticResource Section}" />
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="AccentOrange" Content="{Binding LabelAccentOrange}" Checked="AccentOrange_Checked" />
                <RadioButton x:Name="AccentBlue" Content="{Binding LabelAccentBlue}" Checked="AccentBlue_Checked" />
                <RadioButton x:Name="AccentPurple" Content="{Binding LabelAccentPurple}" Checked="AccentPurple_Checked" />
                <RadioButton x:Name="AccentGreen" Content="{Binding LabelAccentGreen}" Checked="AccentGreen_Checked" />
            </StackPanel>

            <CheckBox x:Name="HumorCheck" Content="{Binding MenuHumor}" Margin="0,18,0,0" Checked="Humor_Changed" Unchecked="Humor_Changed" />
            <TextBlock Text="{Binding LabelHumorNote}" Style="{StaticResource Muted}" Margin="0,4,0,0" />

            <CheckBox x:Name="AutostartCheck" Content="{Binding LabelAutostart}" Margin="0,14,0,0" Checked="Autostart_Changed" Unchecked="Autostart_Changed" />
            <TextBlock Text="{Binding LabelAutostartNote}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
            <TextBlock x:Name="AutostartStatus"
                       Foreground="#FF8A80"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"
                       Visibility="Collapsed" />

            <TextBlock Text="{Binding LabelContextTitle}" Style="{StaticResource Section}" />
            <CheckBox x:Name="ContextCheck" Content="{Binding LabelContextEnabled}" Checked="Context_Changed" Unchecked="Context_Changed" />
            <CheckBox x:Name="SafeShareCheck" Content="{Binding LabelSafeShare}" Margin="0,10,0,0" Checked="SafeShare_Changed" Unchecked="SafeShare_Changed" />
            <TextBlock Text="{Binding LabelSafeShareNote}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
            <TextBlock Text="{Binding LabelContextNote}" Style="{StaticResource Muted}" Margin="0,8,0,0" />

            <CheckBox x:Name="HabitsCheck" Content="{Binding LabelHabits}" Margin="0,14,0,0" Checked="Habits_Changed" Unchecked="Habits_Changed" />
            <TextBlock Text="{Binding LabelHabitsNote}" Style="{StaticResource Muted}" Margin="0,4,0,0" />

            <CheckBox x:Name="PrayerCheck" Content="{Binding LabelPrayer}" Margin="0,14,0,0" Checked="Prayer_Changed" Unchecked="Prayer_Changed" />
            <TextBlock Text="{Binding LabelPrayerNote}" Style="{StaticResource Muted}" Margin="0,4,0,0" />

            <CheckBox x:Name="OledCheck" Content="{Binding LabelOled}" Margin="0,14,0,0" Checked="Oled_Changed" Unchecked="Oled_Changed" />

            <CheckBox x:Name="WeatherCheck" Content="{Binding LabelWeather}" Margin="0,14,0,0" Checked="Weather_Changed" Unchecked="Weather_Changed" />
            <TextBlock Text="{Binding LabelWeatherNote}" Style="{StaticResource Muted}" Margin="0,4,0,0" />

            <TextBlock Text="{Binding LabelModulesNote}" Style="{StaticResource Section}" />

            <CheckBox x:Name="ClipboardCheck" Content="{Binding LabelClipboard}" Checked="Clipboard_Changed" Unchecked="Clipboard_Changed" />
            <TextBlock Text="{Binding LabelClipboardNote}" Style="{StaticResource Muted}" Margin="0,4,0,0" />

            <CheckBox x:Name="PaletteCheck" Content="{Binding LabelPalette}" Margin="0,14,0,0" Checked="Palette_Changed" Unchecked="Palette_Changed" />

            <CheckBox x:Name="OsdCheck" Content="{Binding LabelOsd}" Margin="0,14,0,0" Checked="Osd_Changed" Unchecked="Osd_Changed" />
            <TextBlock Text="{Binding LabelOsdNote}" Style="{StaticResource Muted}" Margin="0,4,0,0" />

            <CheckBox x:Name="MirrorCheck" Content="{Binding LabelMirror}" Margin="0,14,0,0" Checked="Mirror_Changed" Unchecked="Mirror_Changed" />
            <TextBlock Text="{Binding LabelMirrorNote}" Style="{StaticResource Muted}" Margin="0,4,0,0" />

            <TextBlock Text="{Binding LabelPermissions}" Style="{StaticResource Muted}" Margin="0,18,0,0" />

            <Button x:Name="PrimaryButton"
                    Content="{Binding LabelClose}"
                    Click="Primary_Click"
                    Height="44"
                    Margin="0,20,0,0"
                    Background="#1FFFFFFF"
                    Foreground="#FFFFFF"
                    BorderThickness="0"
                    FontSize="14"
                    FontWeight="Medium"
                    Cursor="Hand" />

            <TextBlock Text="{Binding LabelVersion}"
                       Foreground="#8A8A8A"
                       FontSize="11"
                       Margin="0,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</Window>
